POSTGRES_PASSWORD=infrawatch_dev
JWT_SECRET=change-me-in-prod
ADMIN_EMAIL=admin@infrawatch.local
ADMIN_PASSWORD=changeme123

# Host ports — change if these collide with something already running on the deploy VM
BACKEND_PORT=8000
FRONTEND_PORT=8080

# The address the frontend/browser uses to reach the backend. Local dev default
# below is fine as-is; for a real deployment set this to the real domain, e.g.
# https://infrawatch.yourdomain.com
API_BASE=http://localhost:8000

# Comma-separated list of allowed frontend origins, or "*" for local dev.
# For a real deployment, set this to match API_BASE's frontend counterpart,
# e.g. https://infrawatch.yourdomain.com
CORS_ORIGINS=*

# Alert email notifications — optional. Leave SMTP_HOST blank to disable
# entirely (no emails, alerts still work fine in-app). Every admin user
# gets emailed when a new alert opens (not on every heartbeat it stays
# active, and not on resolution).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Used to build a "view in InfraWatch" link in alert emails, e.g.
# https://infrawatch.yourdomain.com
FRONTEND_URL=
